<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace 必须指向 Mapper 接口的全限定名 -->
<mapper namespace="com.csii.common.dao.UserMapper">

    <!-- 通用结果映射：数据库下划线 -> Java 驼峰 -->
    <resultMap id="BaseResultMap" type="com.csii.common.entity.UserEntity">
        <id column="id" property="id"/>
        <result column="user_name" property="userName"/>
        <result column="password" property="password"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_name, password, status, remark, create_time, update_time
    </sql>

    <!-- 根据姓名模糊查询 -->
    <select id="selectByNameLike" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE name LIKE CONCAT('%', #{name}, '%')
    </select>

</mapper>